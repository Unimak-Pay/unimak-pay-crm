# ── Server only (never NEXT_PUBLIC_) ─────────────────────────────────────────
# Backend the /api/unimak proxy forwards to. Local backend with MONIME_MODE=mock:
UNIMAK_API_URL=http://localhost:3100
# Production: https://unimak-pay-backend.vercel.app
# Outside NODE_ENV=production the proxy refuses POST/PUT/PATCH/DELETE to the
# production host. Set to "true" only if you really mean to move real money.
ALLOW_PROD_WRITES=false

# ── Public (shipped to the browser) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable anon key>
# "msw" = mock the admin API (and Supabase auth) in the browser; see README
NEXT_PUBLIC_API_MOCKING=
